{% liquid
  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif
%}

<div
  class="section-background{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
></div>
<div
  class="section section--page-width shop-by-occasion-section{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %} spacing-style"
  style="{% render 'spacing-style', settings: section.settings %}"
>
  <div class="shop-by-occasion__wrapper">
    {% if section.settings.heading != blank %}
      <h2 class="shop-by-occasion__heading" style="{% if section.settings.heading_color != blank %}color: {{ section.settings.heading_color }};{% endif %}">
        {{ section.settings.heading }}
      </h2>
    {% endif %}

    <div class="shop-by-occasion__slider-container">
      <div class="shop-by-occasion__track">
        {% for block in section.blocks %}
          <div class="shop-by-occasion__item" {{ block.shopify_attributes }}>
            <a href="{{ block.settings.link | default: '#' }}" class="shop-by-occasion__link">
              <div class="shop-by-occasion__image-wrapper">
                {% if block.settings.image != blank %}
                  {{ block.settings.image | image_url: width: 400 | image_tag: 
                    loading: 'lazy',
                    class: 'shop-by-occasion__image',
                    alt: block.settings.title | escape
                  }}
                {% else %}
                  {{ 'image' | placeholder_svg_tag: 'shop-by-occasion__placeholder' }}
                {% endif %}
              </div>
              {% if block.settings.title != blank %}
                <span class="shop-by-occasion__title" style="{% if section.settings.text_color != blank %}color: {{ section.settings.text_color }};{% endif %}">
                  {{ block.settings.title }}
                </span>
              {% endif %}
            </a>
          </div>
        {% endfor %}
      </div>
    </div>
  </div>
</div>

{% stylesheet %}
  .shop-by-occasion-section {
    position: relative;
    width: 100%;
    clear: both;
    display: block;
  }

  .shop-by-occasion__wrapper {
    width: 100%;
    margin: 0 auto;
    position: relative;
    padding: 0 16px;
  }

  .shop-by-occasion__heading {
    text-align: center;
    font-family: var(--font-heading-family, inherit);
    font-size: 1.5rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin-top: 0;
    margin-bottom: 28px;
    color: #7A1C2C;
    font-weight: 500;
  }

  .shop-by-occasion__slider-container {
    position: relative;
    display: flex;
    align-items: center;
    width: 100%;
  }

  .shop-by-occasion__track {
    display: flex;
    gap: 32px;
    overflow-x: auto;
    scroll-behavior: smooth;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    padding: 12px 4px;
    width: 100%;
    justify-content: center;
  }

  .shop-by-occasion__track::-webkit-scrollbar {
    display: none;
  }

  @media screen and (max-width: 989px) {
    .shop-by-occasion__track {
      justify-content: flex-start;
      gap: 20px;
    }
    .shop-by-occasion__wrapper {
      padding: 0 16px;
    }
  }

  .shop-by-occasion__item {
    flex: 0 0 auto;
    width: 160px;
    text-align: center;
    scroll-snap-align: center;
  }

  @media screen and (max-width: 749px) {
    .shop-by-occasion__item {
      width: 120px;
    }
  }

  .shop-by-occasion__link {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-decoration: none;
    color: inherit;
    transition: transform 0.2s ease;
  }

  .shop-by-occasion__link:hover {
    transform: translateY(-4px);
  }

  .shop-by-occasion__image-wrapper {
    width: 160px;
    height: 160px;
    min-width: 160px;
    min-height: 160px;
    border-radius: 50%;
    overflow: hidden;
    position: relative;
    background-color: #f0f0f0;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.08);
    transition: box-shadow 0.3s ease, transform 0.3s ease;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  @media screen and (max-width: 749px) {
    .shop-by-occasion__image-wrapper {
      width: 120px;
      height: 120px;
      min-width: 120px;
      min-height: 120px;
    }
  }

  .shop-by-occasion__link:hover .shop-by-occasion__image-wrapper {
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.16);
  }

  .shop-by-occasion__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }

  .shop-by-occasion__link:hover .shop-by-occasion__image {
    transform: scale(1.06);
  }

  .shop-by-occasion__image-wrapper svg,
  .shop-by-occasion__placeholder {
    width: 48px !important;
    height: 48px !important;
    max-width: 50%;
    max-height: 50%;
    opacity: 0.45;
  }

  .shop-by-occasion__title {
    margin-top: 12px;
    font-size: 1rem;
    font-weight: 500;
    color: #7A1C2C;
    letter-spacing: 0.02em;
    transition: color 0.2s ease;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Shop by Occasion",
  "tag": "section",
  "class": "section-shop-by-occasion",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "SHOP BY OCCASION"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#7A1C2C"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#7A1C2C"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top Padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom Padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "occasion",
      "name": "Occasion",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Occasion Name"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shop by Occasion",
      "blocks": [
        {
          "type": "occasion",
          "settings": {
            "title": "Wedding"
          }
        },
        {
          "type": "occasion",
          "settings": {
            "title": "Festive"
          }
        },
        {
          "type": "occasion",
          "settings": {
            "title": "Casual"
          }
        },
        {
          "type": "occasion",
          "settings": {
            "title": "Formal"
          }
        },
        {
          "type": "occasion",
          "settings": {
            "title": "Party"
          }
        }
      ]
    }
  ]
}
{% endschema %}
